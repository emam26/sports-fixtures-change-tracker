SQL_SERVER_HOST=
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=SportsFixturesTracker
SQL_SERVER_USER=sports_tracker_app
SQL_SERVER_PASSWORD=
SQL_SERVER_ENCRYPT=yes
SQL_SERVER_TRUST_CERTIFICATE=yes
OPENLIGADB_BASE_URL=https://api.openligadb.de
OPENLIGADB_SHORTCUT=ucl
OPENLIGADB_SEASON=2026
OPENLIGADB_EXPECTED_LEAGUE_ID=4946
OPENLIGADB_TIMEOUT_SECONDS=10
RAW_SNAPSHOT_DIRECTORY=data/raw
OPENLIGADB_LEAGUE_PHASE_MATCHDAYS=1,2,3,4,5,6,7,8
OPENLIGADB_EXPECTED_FIXTURES_PER_MATCHDAY=18
# Leave blank to let the synchronizer discover provider-advertised matchdays.
OPENLIGADB_MATCHDAYS=
OPENLIGADB_DISCOVER_MATCHDAYS=yes
# Keep knockout-stage groups out of synchronization until their source shape is reviewed.
OPENLIGADB_INCLUDE_POST_LEAGUE_PHASE=no
OPENLIGADB_MAX_RETRIES=3
OPENLIGADB_BACKOFF_INITIAL_SECONDS=1
OPENLIGADB_BACKOFF_MAX_SECONDS=8
SYNC_LOCK_FILE=data/runtime/sync.lock
SYNC_LOG_DIRECTORY=data/runtime/logs
API_LOCAL_ONLY=yes
API_ALLOW_NOTE_WRITES=no
API_NOTES_WRITE_TOKEN=
